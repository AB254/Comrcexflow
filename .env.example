# ============================================
# Shopify App Credentials
# Get these from your Shopify Partner Dashboard
# ============================================
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SCOPES=write_products,read_orders,write_orders,read_checkouts,write_checkouts,read_customers

# ============================================
# App URL
# Development: use the URL from `shopify app dev`
# Production: your deployed domain (e.g., https://comrcexflow.fly.dev)
# ============================================
SHOPIFY_APP_URL=https://your-app-url.fly.dev
HOST=https://your-app-url.fly.dev

# ============================================
# Database (PostgreSQL)
# Development: local Docker Postgres
# Production: managed Postgres (Render, Fly, Supabase, etc.)
# ============================================
DATABASE_URL=postgresql://comrcexflow:comrcexflow_dev@localhost:5432/comrcexflow?schema=public

# ============================================
# Redis (for BullMQ message queues)
# Development: local Docker Redis
# Production: managed Redis (Render, Upstash, Fly, etc.)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Internal Communication
# Secret shared between web server and worker process
# Generate with: openssl rand -hex 32
# ============================================
INTERNAL_WORKER_SECRET=change-me-to-a-random-secret

# ============================================
# Developer Bypass Key
# When a merchant enters this key in Settings,
# they get unlimited messages with no billing.
# Keep this secret and share only with trusted partners.
# ============================================
MASTER_BYPASS_KEY=your-super-secret-agency-key

# ============================================
# Docker Compose Overrides (production only)
# ============================================
# POSTGRES_PASSWORD=strong-production-password
# NODE_ENV=production
# PORT=3000
